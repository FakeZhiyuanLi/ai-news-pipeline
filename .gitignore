# Secrets — never commit; .env was committed once already and had to be removed.
# .env.example is the opposite: it carries no values and documents which keys
# a new checkout needs, so it must stay tracked.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Pipeline output. Run directories are the unit of work and are disposable;
# costs.jsonl and the ledger are local state that would conflict on every run.
runs/
costs.jsonl
ledger.json

# Bench output: regenerated on demand, one file per invocation.
# tests/fixtures/ is deliberately NOT ignored — run.py --selftest replays
# those recorded responses, so they are source, not output.
data/bench/

# Renderer. package-lock.json IS tracked so the pinned versions are
# reproducible; props.json and public/ are generated per run by
# `python run.py --update-props`.
renderer/node_modules/
renderer/props.json
renderer/public/
renderer/out/

# Narration cache and rendered media. audio/ is keyed by a hash of the exact
# synthesis inputs — regenerable, but only by spending credits, so do not
# delete it casually.
audio/
*.mp3
*.mp4
*.wav

# OS and editor
.DS_Store
*.swp
.idea/
.vscode/
